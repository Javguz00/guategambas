generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Modelo para administradores del sistema
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // hash bcrypt
  name      String
  role      UserRole @default(ADMIN)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Categorías de gambas (ej: Criadas, Silvestres, Premium, etc)
model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?   // emoji o nombre de icono
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Productos (gambas)
model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  price       Float       // precio en GTQ
  stock       Int         @default(0) // cantidad disponible
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  image       String?     // URL o nombre del archivo de imagen (compatibilidad, = images[0])
  images      String[]    @default([]) // galería completa de imágenes/videos
  brand       String?     // marca del producto
  active      Boolean     @default(true)
  featured    Boolean     @default(false) // para destacar en la página principal
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId])
  @@index([slug])
}

// Órdenes de clientes
model Order {
  id              String      @id @default(cuid())
  customerName    String
  customerEmail   String
  customerPhone   String      // WhatsApp o teléfono
  city            String
  department      String?     // departamento de Guatemala
  address         String?     // dirección de entrega
  notes           String?     // notas especiales
  items           OrderItem[]
  subtotal        Float       // suma de items
  shippingCost    Float       @default(0)
  total           Float       // subtotal + shipping
  status          OrderStatus @default(PENDING)
  paymentMethod   PaymentMethod @default(CONTRAENTREGA)
  paymentStatus   PaymentStatus @default(PENDING)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// Items dentro de cada orden
model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  price     Float    // precio al momento de la compra
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

// Almacenamiento de multimedia para productos y hero
model MediaAsset {
  id        String   @id @default(cuid())
  filename  String   @unique
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Mapeo de multimedia a producto o hero
model MediaMapping {
  id        String   @id @default(cuid())
  productId String
  filename  String
  grade     String?
  slot      String?
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([productId, slot])
  @@index([productId, filename])
}

// Enums
enum UserRole {
  ADMIN
  OWNER
}

enum OrderStatus {
  PENDING       // Pedido recibido, esperando confirmación
  CONFIRMED     // Confirmado por admin
  PROCESSING    // En preparación
  SHIPPED       // Enviado
  DELIVERED     // Entregado
  CANCELLED     // Cancelado
}

enum PaymentMethod {
  CONTRAENTREGA      // Pago contra entrega
  DEPOSITO_PREVIO    // Depósito previo
  TARJETA           // Tarjeta de crédito/débito
}

enum PaymentStatus {
  PENDING   // Esperando pago
  PAID      // Pagado
  FAILED    // Falló el pago
  CANCELLED // Cancelado
}
