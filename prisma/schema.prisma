generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id               String        @id @default(cuid())
  customerName     String
  whatsapp         String
  city             String
  notes            String?
  items            Json
  total            Float
  createdAt        DateTime      @default(now())
  status           OrderStatus   @default(PENDING)
  departamento     String?
  paymentMethod    PaymentMethod @default(PAGO_CONTRAENTREGA)
  shippingCost     Float         @default(0)
  email            String?
  paymentProvider  String?
  paymentReference String?
  paymentStatus    PaymentStatus @default(PENDING)
}

model Cart {
  id        String   @id @default(cuid())
  key       String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id         String   @id @default(cuid())
  fullName   String
  whatsapp   String   @unique
  email      String?
  department String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CRMProduct {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String?
  basePrice   Float
  stock       Int?
  active      Boolean  @default(true)
  gradeLabel  String?
  unitLabel   String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PaymentAttempt {
  id                String        @id @default(cuid())
  orderId           String?
  provider          String        @default("CUBO")
  providerReference String?
  amount            Float
  currency          String        @default("GTQ")
  status            PaymentStatus @default(DRAFT)
  customerName      String
  customerWhatsapp  String
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model CatalogVariantState {
  productId      String
  variantId      String
  stockAvailable Int?
  isActive       Boolean  @default(true)
  updatedAt      DateTime @updatedAt
  priceOverride  Float?

  @@id([productId, variantId])
}

model CatalogProductState {
  productId   String   @id
  name        String?
  category    String?
  description String?
  highlight   String?
  note        String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model MediaAsset {
  id        String   @id @default(cuid())
  filename  String   @unique
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MediaMapping {
  id        String   @id @default(cuid())
  productId String
  filename  String
  grade     String?
  slot      String?
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([productId, slot])
  @@index([productId, filename])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
}

enum PaymentMethod {
  DEPOSITO_PREVIO
  PAGO_CONTRAENTREGA
  TARJETA_CUBO
}

enum PaymentStatus {
  DRAFT
  PENDING
  PAID
  FAILED
  CANCELED
}
