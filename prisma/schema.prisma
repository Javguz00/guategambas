generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
}

enum PaymentMethod {
  DEPOSITO_PREVIO
  PAGO_CONTRAENTREGA
}

model Order {
  id              String        @id @default(cuid())
  customerName    String
  whatsapp        String
  city            String
  departamento    String?
  paymentMethod   PaymentMethod @default(PAGO_CONTRAENTREGA)
  notes           String?
  items           Json
  total           Float
  shippingCost    Float         @default(0)
  status          OrderStatus   @default(PENDING)
  createdAt       DateTime      @default(now())
}

model CatalogVariantState {
  productId      String
  variantId      String
  stockAvailable Int?
  isActive       Boolean  @default(true)
  priceOverride  Float?
  updatedAt      DateTime @updatedAt

  @@id([productId, variantId])
}
