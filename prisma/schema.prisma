generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id           String   @id @default(cuid())
  customerName String
  whatsapp     String
  city         String
  notes        String?
  items        Json
  total        Float
  createdAt    DateTime @default(now())
}
