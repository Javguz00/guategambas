# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"
# DIRECT_URL should be a non-pooled/direct Postgres URL for Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"
# Vercel Postgres typically provides a URL like:
# DATABASE_URL="postgres://user:password@host:5432/db?sslmode=require"
# DIRECT_URL="postgres://user:password@host:5432/db?sslmode=require"

